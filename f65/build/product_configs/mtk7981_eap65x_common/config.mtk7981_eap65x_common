# as one more co-edition board of the Omada EAP65x firmware, the same way Festa F76 rides on the EAP772
# firmware. mkits.sh turns mt7981-Festa_F65_1_0_0 into FIT config "config@Festa_F65_1_0_0", which is the
# config_name in the F65 factory device-info. It is the only (and therefore default) FIT config.
#
# The original EAP65x board list is kept below for reference. It is not built because TP-Link's EAP650
# GPL drop does not ship the per-model /etc/<model>/ configuration directories for those boards, so an
# image built from this tree would not boot correctly on them.
#DTBPREFIX=mt7981-EAP650_3_0_0 mt7981-EAP653_3_0_0 mt7981-EAP655-WE_1_0_0 mt7981-EAP655-WE-AC_1_0_0 mt7981-EAP650-Wall_2_0_0 mt7981-EAP653_UR_1_0_0 mt7981-EAP653_UR_2_0_0 mt7981-EAP653_2_0_0 mt7981-EAP650_2_0_0
