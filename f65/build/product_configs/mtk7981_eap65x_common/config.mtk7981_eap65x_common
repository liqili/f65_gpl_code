# but TP-Link did not ship their sources (openldap, cyrus-sasl, freeradius, libcli). Their prebuilt
# binaries are already in images/eap/$(BOARD_TYPE)/rootfs, so keep those instead of rebuilding.
export APPS_EXCLUDE ?= freeradius libcli
# The prebuilt busybox in the rootfs is TP-Link's patched build (TP_BUSYBOX_MODIFY: udhcpc reports
# lease changes to the management daemons through libunixsock_lib.so). Those patches need private
# headers that are not in the GPL drop, so rebuilding busybox would silently drop them. Keep the
# prebuilt one; pass EVERYTHING_EXCLUDE= on the make command line to rebuild it anyway.
export EVERYTHING_EXCLUDE ?= busybox



